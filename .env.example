# Upstash Redis — stockage partagé des données de l'app.
# Ces variables sont fournies automatiquement quand tu ajoutes
# l'intégration Upstash (Redis) à ton projet depuis le tableau de bord Vercel
# (Storage > Upstash for Redis / Marketplace).
#
# En local, crée un fichier .env.local avec tes propres valeurs.
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxx"

# Code PIN du mode parents (optionnel).
# Si absent, la valeur par défaut "180586" est utilisée.
NEXT_PUBLIC_PARENT_PIN="180586"
